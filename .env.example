# anthropic api key for the rater sub-agent
ANTHROPIC_API_KEY=sk-ant-...

# gemini api key (for running gemini models via the gemini developer api)
GEMINI_API_KEY=...

# --- gemini via vertex ai + application default credentials (ADC) ---
# alternative to GEMINI_API_KEY: auth with ADC instead of an api key.
# run `gcloud auth application-default login` (or set GOOGLE_APPLICATION_CREDENTIALS
# to a service-account key file) and flip the flag below.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# default rater model (any id from /api/config models list)
VALOR_RATER_MODEL=gemini-2.5-flash

# sqlite paths (defaults are fine)
VALOR_DB_URL=sqlite:///data/valor.db
VALOR_CHECKPOINT_DB=data/checkpoints.db

# playwright runtime
VALOR_HEADLESS=true

# crawl bounds
VALOR_MAX_PAGES=3
VALOR_MAX_DETAIL_CONCURRENCY=3
