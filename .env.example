# anthropic api key for the rater sub-agent
ANTHROPIC_API_KEY=sk-ant-...

# gemini api key (for running gemini models)
GEMINI_API_KEY=...

# sqlite paths (defaults are fine)
VALOR_DB_URL=sqlite:///data/valor.db
VALOR_CHECKPOINT_DB=data/checkpoints.db

# playwright runtime
VALOR_HEADLESS=true

# crawl bounds
VALOR_MAX_PAGES=3
VALOR_MAX_DETAIL_CONCURRENCY=3
